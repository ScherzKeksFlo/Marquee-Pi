<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Library</OutputType>
    <AssemblyName>MarqueePiLaunchBox</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <LaunchBoxPluginDll Condition="Exists('$(LaunchBoxRoot)\Core\Unbroken.LaunchBox.Plugins.dll')">$(LaunchBoxRoot)\Core\Unbroken.LaunchBox.Plugins.dll</LaunchBoxPluginDll>
    <LaunchBoxPluginDll Condition="'$(LaunchBoxPluginDll)' == ''">$(LaunchBoxRoot)\Metadata\Unbroken.LaunchBox.Plugins.dll</LaunchBoxPluginDll>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Unbroken.LaunchBox.Plugins">
      <HintPath>$(LaunchBoxPluginDll)</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="System.Runtime.Serialization" />
  </ItemGroup>
  <Target Name="CheckLaunchBoxReference" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(LaunchBoxPluginDll)')"
           Text="Set LaunchBoxRoot to the local LaunchBox directory (dotnet build -p:LaunchBoxRoot=...). The proprietary DLL is not included." />
  </Target>
</Project>

[Unit]
Description=Marquee-Pi boot splash
After=local-fs.target
Before=marquee-pi-kiosk.service
ConditionPathExists=/var/lib/marquee-pi/boot-splash
ConditionPathExists=/dev/fb0

[Service]
Type=simple
ExecStart=/usr/bin/fbi -T 1 -d /dev/fb0 -a -noverbose -nointeractive /var/lib/marquee-pi/boot-splash
StandardInput=tty
StandardOutput=journal
StandardError=journal
TTYPath=/dev/tty1
TTYReset=yes
Restart=no
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target

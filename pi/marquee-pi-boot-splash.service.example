[Unit]
Description=Marquee-Pi boot splash
Wants=dev-fb0.device
After=local-fs.target dev-fb0.device
Before=arcade-pi-kiosk.service
ConditionPathExists=/var/lib/arcade-pi-display/boot-splash
ConditionPathExists=/dev/fb0

[Service]
Type=simple
ExecStart=/usr/bin/fbi -T 1 -d /dev/fb0 -a -noverbose -nointeractive /var/lib/arcade-pi-display/boot-splash
StandardInput=tty
StandardOutput=journal
StandardError=journal
TTYPath=/dev/tty1
TTYReset=yes
Restart=no
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target

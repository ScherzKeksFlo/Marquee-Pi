[Unit]
Description=Marquee-Pi API
After=network.target

[Service]
Type=simple
User=marqueepi
ExecStart=/usr/bin/python3 /opt/marquee-pi/marquee_pi.py --config /etc/marquee-pi/config.json
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/marquee-pi -/sys/devices/platform/rpi_backlight
SupplementaryGroups=video
PrivateTmp=true

[Install]
WantedBy=multi-user.target

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>ArcadePiTray</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Resources\connected.ico" LogicalName="ArcadePiTray.ConnectedIcon" />
    <EmbeddedResource Include="Resources\disconnected.ico" LogicalName="ArcadePiTray.DisconnectedIcon" />
  </ItemGroup>
</Project>
